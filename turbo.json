{
  "$schema": "https://turbo.build/json-schema.json",
  "globalDependencies": [
    "**/.env.local",
    "**/.env",
    "tsconfig.json"
  ],
  "pipeline": {
    "type-check": {
      "outputs": [],
      "cache": false
    },
    "lint": {
      "outputs": [],
      "cache": false
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "dev": {
      "outputs": [],
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [".next", "dist"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js",
        "src/**/*.jsx"
      ]
    },
    "test": {
      "outputs": ["coverage"],
      "cache": false
    }
  }
}
